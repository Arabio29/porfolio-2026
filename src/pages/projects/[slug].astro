---
import Base from '../../layouts/Base.astro';import {projects} from '../../data/projects';import {profile} from '../../data/profile';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project}=Astro.props;const index=projects.findIndex(p=>p.slug===project.slug);const next=projects[(index+1)%projects.length];
---
<Base title={`${project.name} — ${profile.name}`} description={project.overview} image={project.image}><article class="case-study"><header class="case-hero section-pad"><a class="text-link" href="/#work">← Back to work</a><div class="chapter mono"><span>{project.category}</span><span>{project.year}</span></div><h1 data-reveal>{project.name}</h1><p class="case-lead">{project.description}</p><div class="case-tags mono">{project.stack.join(' / ')}</div></header><figure class="case-cover"><img src={project.image} alt={project.alt} width="1440" height="900" transition:name={`project-${project.slug}`} fetchpriority="high"/></figure><div class="case-body section-pad"><section class="case-row"><h2>Overview</h2><div><p>{project.overview}</p><h3>Role</h3><p>{project.role}</p></div></section><section class="case-row"><h2>The problem</h2><p>{project.problem}</p></section><section id="architecture" class="case-architecture"><div class="architecture-sticky"><span class="mono">SYSTEM ARCHITECTURE</span><h2>One system.<br/>Distinct layers.</h2><div class="architecture-diagram" aria-label="Content flows through input, experience and resilience layers">{project.architecture.map((a,i)=><div><span class="mono">0{i+1}</span><strong>{a.name}</strong><span aria-hidden="true">↓</span></div>)}</div></div><div class="architecture-steps">{project.architecture.map((a,i)=><section><span class="mono">LAYER / 0{i+1}</span><h3>{a.name}</h3><p>{a.detail}</p></section>)}</div></section><section class="case-row"><h2>The process</h2><ol class="process-list">{project.process.map(p=><li>{p}</li>)}</ol></section><section class="case-row"><h2>The solution</h2><p>{project.solution}</p></section><div class="case-screenshots">{project.screenshots.map(s=><figure><img src={s.src} alt={s.alt} loading="lazy" width="1440" height="900"/><figcaption class="mono">{s.caption}</figcaption></figure>)}</div><section class="case-row"><h2>The challenge</h2><p>{project.challenges}</p></section><section class="case-row"><h2>The outcome</h2><p>{project.results}</p></section><a class="next-project" href={projects.length>1?`/projects/${next.slug}/`:'/#lab'}><span class="mono">{projects.length>1?'NEXT PROJECT':'CONTINUE EXPLORING'}</span><strong>{projects.length>1?next.name:'Enter the lab'} ↗</strong></a></div></article></Base>
