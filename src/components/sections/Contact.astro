---
import { profile } from '../../data/profile';
import { socials } from '../../data/socials';
import { copy } from '../../data/interface';

const channels = [
  { id: 'email', label: 'EMAIL', value: profile.email, href: `mailto:${profile.email}`, cursor: 'COPY EMAIL', copy: true },
  ...(socials.whatsapp
    ? [{ id: 'whatsapp', label: 'WHATSAPP', value: '+57 321 959 1377', href: `https://wa.me/${socials.whatsapp}?text=${encodeURIComponent('Hi Eliasib, I saw your portfolio — let’s talk.')}`, cursor: 'CHAT', external: true }]
    : []),
  { id: 'github', label: 'GITHUB', value: '@Arabio29', href: socials.github, cursor: 'OPEN', external: true },
  ...(socials.linkedin
    ? [{ id: 'linkedin', label: 'LINKEDIN', value: 'in/eliasib-cantor', href: socials.linkedin, cursor: 'OPEN', external: true }]
    : []),
  ...(socials.website
    ? [{ id: 'website', label: 'WEBSITE', value: socials.website.replace('https://', ''), href: socials.website, cursor: 'OPEN', external: true }]
    : []),
];
---

<section id="contact" class="contact section-pad" aria-labelledby="contact-title">
  <div class="chapter mono"><span>05 / NEXT CONNECTION</span><span>YOUR IDEA. OUR NEXT CHAPTER.</span></div>
  <div class="contact-heading">
    <div><span class="mono contact-kicker">OPEN CHANNEL</span><h2 id="contact-title">{profile.contactTitle.map((line, index) => <span data-reveal class:list={[{ 'contact-outline': index === 2 }]}>{line}</span>)}</h2></div>
    <p>{copy.contactNote}</p>
  </div>
  <p class="mono channel-status" data-reveal><i aria-hidden="true"></i>{profile.availability} — {profile.location} → {profile.reach}</p>

  <div class="channels">
    {channels.map((channel, index) => (
      channel.copy ? (
        <button class="channel" data-copy-email={channel.value} data-cursor={channel.cursor} data-reveal aria-label={`Copy ${channel.label} address ${channel.value}`}>
          <span class="mono channel-index">0{index + 1}</span>
          <span class="channel-label">{channel.label}</span>
          <span class="mono channel-value">{channel.value}</span>
          <span class="channel-arrow" aria-hidden="true">⧉</span>
        </button>
      ) : (
        <a class="channel" href={channel.href} target="_blank" rel="noopener noreferrer" data-cursor={channel.cursor} data-reveal aria-label={`Open ${channel.label} ${channel.value}`}>
          <span class="mono channel-index">0{index + 1}</span>
          <span class="channel-label">{channel.label}</span>
          <span class="mono channel-value">{channel.value}</span>
          <span class="channel-arrow" aria-hidden="true">↗</span>
        </a>
      )
    ))}
  </div>

  {!profile.email && <p class="editor-note mono">{copy.missingEmail}</p>}
  <footer class="site-footer mono"><span>© {profile.name.toUpperCase()} / {profile.role.toUpperCase()}</span><span>BUILT WITH INTENT.</span><a href="#hero">BACK TO TOP ↑</a></footer>
</section>
