---
import { projects } from '../../data/projects';
import { copy } from '../../data/interface';
---

<section id="work" class="work section-pad" aria-labelledby="work-title">
  <div class="chapter mono"><span>02 / SELECTED WORK</span><span>FORM FOLLOWS FUNCTION. THEN FEELING.</span></div>
  <div class="section-heading">
    <h2 id="work-title">{copy.workTitle.map((line) => <span data-reveal>{line}</span>)}</h2>
    <p>{copy.workNote}</p>
  </div>
  <div class="work-index mono" aria-hidden="true"><span>PROJECT / {String(projects.length).padStart(2, '0')}</span><span>SCROLL TO INSPECT</span></div>
  <div class="project-gallery">
    {projects.map((project, index) => (
      <article class="project" data-project={project.slug}>
        <a href={`/projects/${project.slug}/`} class="project-visual" data-project-link data-cursor="VIEW PROJECT" aria-label={`View ${project.name} case study`}>
          <div class="project-image">
            <img data-webgl-image src={project.image} alt={project.alt} width="1600" height="1000" loading={index === 0 ? 'eager' : 'lazy'} transition:name={`project-${project.slug}`} />
            <span class="project-scan mono" aria-hidden="true">SCAN / 0{index + 1}</span>
          </div>
          <span class="project-image-label mono">{project.category}</span>
          <span class="project-open" aria-hidden="true">↗</span>
        </a>
        <div class="project-caption">
          <span class="mono project-number">[ 0{index + 1} ]</span>
          <div><h3><a href={`/projects/${project.slug}/`}>{project.name}</a></h3><p>{project.description}</p></div>
          <span class="mono project-stack">{project.stack.join(' / ')}<br />{project.year}</span>
        </div>
      </article>
    ))}
  </div>
</section>
