---
import {projects} from '../../data/projects';import {copy} from '../../data/interface';
---
<section id="work" class="work section-pad"><div class="chapter mono"><span>02 / SELECTED WORK</span><span>FORM FOLLOWS FUNCTION. THEN FEELING.</span></div><div class="section-heading"><h2>{copy.workTitle.map(t=><span data-reveal>{t}</span>)}</h2><p>{copy.workNote}</p></div><div class="project-gallery">{projects.map((p,i)=><article class="project"><a href={`/projects/${p.slug}/`} class="project-visual" data-project-link data-cursor="VIEW PROJECT"><div class="project-image"><img data-webgl-image src={p.image} alt={p.alt} width="1440" height="900" loading="lazy" transition:name={`project-${p.slug}`}/></div><span class="project-image-label mono">{p.category}</span><span class="project-open" aria-hidden="true">↗</span></a><div class="project-caption"><span class="mono project-number">[ 0{i+1} ]</span><div><h3><a href={`/projects/${p.slug}/`}>{p.name}</a></h3><p>{p.description}</p></div><span class="mono project-stack">{p.stack.join(' / ')}<br/>{p.year}</span></div></article>)}</div></section>
