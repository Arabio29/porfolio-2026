---
import { experience } from '../../data/experience';
import { copy } from '../../data/interface';
---

<section id="experience" class="experience section-pad" aria-labelledby="experience-title">
  <div class="chapter mono"><span>03 / ENGINEERING PRACTICE</span><span>DEPTH OVER LABELS</span></div>
  <div class="section-heading">
    <div class="experience-game" data-experience-game>
      <h2 id="experience-title" class="sr-only">Engineering practice: a desert drive</h2>
      <div class="experience-game-top">
        <span class="mono">DESERT / 01</span>
        <span class="mono">ARROWS / WASD / R RESET</span>
      </div>
      <div class="experience-game-board" data-experience-board tabindex="0" role="group" aria-label="Desert driving world controlled by arrow keys or W A S D" aria-describedby="experience-game-instructions">
        <canvas data-experience-game-canvas aria-hidden="true"></canvas>
        <canvas data-experience-game-hud aria-hidden="true"></canvas>
        <div class="experience-game-base" data-base-panel hidden aria-live="polite">
          <div class="experience-base-head mono"><span data-base-index>01</span><span data-base-discipline></span></div>
          <h4 data-base-name></h4>
          <p data-base-description></p>
          <span class="mono experience-base-tech" data-base-technologies></span>
        </div>
        <div class="experience-game-overlay" aria-hidden="true"><span class="mono">DESERT / 3 BASES</span><span class="mono" data-game-status>CAR / READY</span></div>
      </div>
      <p id="experience-game-instructions" class="experience-game-instructions">Focus the desert, then drive with the arrow keys or <strong>W A S D</strong> — the animated key cluster mirrors your input. Three bases hold the practice layers — stop next to one to read it. The sector map in the top-left corner tracks the car, the solids and the bases. Dunes, cacti, rocks and bases are solid: you will slide around them. Press <strong>R</strong> to return to the origin. The world listens only while this section is visible.</p>
    </div>
    <p>{copy.experienceNote}</p>
  </div>
  {experience.length > 0 && (
    <div class="career-history">
      {experience.map((item) => <article class="depth-plane"><p class="mono">{item.period} / {item.location}</p><h3>{item.role}</h3><h4>{item.company}</h4><p>{item.description}</p><p>{item.technologies.join(' / ')}</p></article>)}
    </div>
  )}
</section>
