---
import { experience, practice } from '../../data/experience';
import { copy } from '../../data/interface';
---

<section id="experience" class="experience section-pad" aria-labelledby="experience-title">
  <div class="chapter mono"><span>03 / ENGINEERING PRACTICE</span><span>DEPTH OVER LABELS</span></div>
  <div class="section-heading">
    <div class="experience-game" data-experience-game>
      <h2 id="experience-title" class="sr-only">Engineering practice: a desert drive</h2>
      <div class="experience-game-top">
        <span class="mono">DESERT / 01</span>
        <span class="mono">ARROWS / WASD / R RESET</span>
      </div>
      <div class="experience-game-board" data-experience-board tabindex="0" role="group" aria-label="Desert driving world controlled by arrow keys or W A S D" aria-describedby="experience-game-instructions">
        <canvas data-experience-game-canvas aria-hidden="true"></canvas>
        <div class="experience-game-overlay" aria-hidden="true"><span class="mono">DESERT / FREE ROAM</span><span class="mono" data-game-status>CAR / READY</span></div>
      </div>
      <p id="experience-game-instructions" class="experience-game-instructions">Focus the desert, then drive with the arrow keys or <strong>W A S D</strong>. Press <strong>R</strong> to return to the origin. The world listens only while this section is visible.</p>
    </div>
    <p>{copy.experienceNote}</p>
  </div>
  <div class="experience-coordinate mono"><span>CAREER / 00—NOW</span><span>THE LAYERS BEHIND THE INTERFACE</span></div>
  <div class="depth-stack">
    {practice.map((item) => (
      <article class="depth-plane">
        <div class="depth-rail mono"><span>{item.discipline}</span><span aria-hidden="true">↗</span></div>
        <span class="depth-index" aria-hidden="true">{item.number}</span>
        <h3>{item.name}</h3>
        <p>{item.description}</p>
        <span class="mono depth-tech">{item.technologies.join(' / ')}</span>
      </article>
    ))}
  </div>
  {experience.length > 0 ? (
    <div class="career-history">
      {experience.map((item) => <article class="depth-plane"><p class="mono">{item.period} / {item.location}</p><h3>{item.role}</h3><h4>{item.company}</h4><p>{item.description}</p><p>{item.technologies.join(' / ')}</p></article>)}
    </div>
  ) : <p class="editor-note mono">{copy.historyNote}</p>}
</section>
