---
import { experience } from '../../data/experience';
import { copy } from '../../data/interface';
---

<section id="experience" class="experience section-pad" aria-labelledby="experience-title">
  <div class="chapter mono"><span>03 / ENGINEERING PRACTICE</span><span>DEPTH OVER LABELS</span></div>
  <div class="section-heading">
    <div class="game-heading">
      <h2 id="experience-title" data-reveal>FIND MY <span>EXPERIENCE.</span></h2>
      <p class="mono">FIVE BASES / FIVE ROLES — DRIVE TO EACH ONE</p>
    </div>
    <div class="experience-game" data-experience-game>
      <div class="experience-game-top">
        <span class="mono">DESERT / 01</span>
        <span class="mono">ARROWS / WASD / R RESET</span>
      </div>
      <div class="experience-game-board" data-experience-board tabindex="0" role="group" aria-label="Desert driving world with five employment bases, controlled by arrow keys or W A S D" aria-describedby="experience-game-instructions">
        <canvas data-experience-game-canvas aria-hidden="true"></canvas>
        <canvas data-experience-game-hud aria-hidden="true"></canvas>
        <div class="experience-game-base" data-base-panel hidden aria-live="polite">
          <div class="experience-base-head mono"><span data-base-index>01</span><span data-base-discipline></span></div>
          <h4 data-base-name></h4>
          <p data-base-description></p>
          <span class="mono experience-base-tech" data-base-technologies></span>
        </div>
        <div class="experience-game-overlay" aria-hidden="true"><span class="mono">DESERT / 5 BASES</span><span class="mono" data-game-status>CAR / READY</span></div>
      </div>
      <p id="experience-game-instructions" class="experience-game-instructions">Focus the desert, then drive with the arrow keys or <strong>W A S D</strong> — the animated key cluster mirrors your input. Five bases hold five real roles, from a first loan system to leading enterprise frontends — stop next to one to read it. The sector map in the top-left corner tracks the car, the solids and the bases. Dunes, cacti, rocks and bases are solid: you will slide around them. Press <strong>R</strong> to return to the origin. The world listens only while this section is visible.</p>
    </div>
    <p>{copy.experienceNote}</p>
  </div>
  {experience.length > 0 && (
    <div class="field-log-wrap">
      <div class="career-label mono"><span>FIELD LOG / EMPLOYMENT RECORD</span><span>2022 → PRESENT</span></div>
      <ol class="field-log">
        {experience.map((item) => (
          <li>
            <div><span class="mono field-no">RECORD</span><strong>{item.role}</strong><span class="mono">{item.company}</span></div>
            <span class="mono">{item.period} / {item.location}</span>
            <p>{item.brief}</p>
            <p class="mono field-tech">{item.technologies.join(' / ')}</p>
          </li>
        ))}
      </ol>
      <p class="mono field-log-note">FULL READOUT INSIDE THE DESERT — DRIVE TO EACH BASE.</p>
    </div>
  )}
</section>
