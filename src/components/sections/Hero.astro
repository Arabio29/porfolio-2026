---
import { profile } from '../../data/profile';
import { copy } from '../../data/interface';
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero-top mono">
    <span>{profile.name.toUpperCase()} / {profile.role.toUpperCase()}</span>
    <span>{profile.location.toUpperCase()} <b aria-hidden="true">→</b> {profile.reach.toUpperCase()}</span>
  </div>

  <div class="hero-grid-mark" aria-hidden="true">
    <span>00</span><span>01</span><span>02</span><span>03</span><span>04</span>
  </div>

  <div class="hero-content">
    <p class="eyebrow mono"><span class="mini-cross">+</span> {copy.system}</p>
    <h1 id="hero-title" aria-label={`${profile.name} — ${profile.role}`}>
      <span class="line-mask"><span data-hero-line>{profile.shortName.toUpperCase()}</span></span>
      <span class="line-mask"><span data-hero-line>SOFTWARE</span></span>
      <span class="line-mask"><span data-hero-line>ENGINEER<span class="title-period">.</span></span></span>
    </h1>
    <div class="hero-byline">
      <span class="mono byline-index">[ E / 01 ]</span>
      <p>{profile.disciplines}<br /><span>{profile.primaryStack.slice(0, 5).join(' · ')}</span></p>
    </div>
  </div>

  <div class="reactor-fallback" aria-hidden="true">
    <div></div><div></div><div></div><span>+</span>
  </div>
  <div class="reactor-caption mono" aria-hidden="true">
    <span>FIG. 01 — CODE REACTOR</span><span>INPUT → STRUCTURE → EXPERIENCE</span>
  </div>

  <div class="hero-bottom">
    <a class="text-link" href="#work" data-cursor="ENTER SYSTEM">Explore the work <span aria-hidden="true">↓</span></a>
    <p>Logic underneath.<br />Feeling on the surface.</p>
    <span class="mono">SCROLL TO ENTER <span class="scroll-tick" aria-hidden="true">↓</span></span>
  </div>
</section>
