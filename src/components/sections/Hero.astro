---
import { profile } from '../../data/profile';
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <h1 id="hero-title" aria-label={`${profile.name} — ${profile.role}`}>
      <span class="line-mask"><span data-hero-line>{profile.shortName.toUpperCase()}</span></span>
      <span class="line-mask"><span data-hero-line>SOFTWARE</span></span>
      <span class="line-mask"><span data-hero-line>ENGINEER<span class="title-period">.</span></span></span>
    </h1>
  </div>

  <div class="reactor-fallback" aria-hidden="true">
    <div></div><div></div><div></div>
  </div>

  <div class="hero-bottom">
    <a class="text-link" href="#work" data-cursor="ENTER SYSTEM">Explore the work <span aria-hidden="true">↓</span></a>
    <span class="mono">SCROLL TO ENTER <span class="scroll-tick" aria-hidden="true">↓</span></span>
  </div>
</section>
