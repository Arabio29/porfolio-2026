---
import {profile} from '../../data/profile';import {copy} from '../../data/interface';
---
<section id="hero" class="hero"><div class="hero-top mono"><span>{profile.name.toUpperCase()} / {profile.role.toUpperCase()}</span><span>{profile.location.toUpperCase()} → {profile.reach.toUpperCase()}</span></div><div class="hero-content"><p class="eyebrow"><span class="mini-cross">+</span> ENGINEERED TO BE FELT.</p><h1 aria-label={`${profile.name} — Software Engineer`}><span class="line-mask"><span data-hero-line>SOFTWARE</span></span><span class="line-mask"><span data-hero-line>ENGINEER<span class="title-period">.</span></span></span></h1><div class="hero-byline"><span class="mono byline-index">[ E / 01 ]</span><p>{profile.disciplines}<br/><span>C# · .NET · Angular · Blazor · TypeScript</span></p></div></div><div class="reactor-fallback" aria-hidden="true"><div></div><div></div><div></div><span>+</span></div><div class="reactor-caption mono" aria-hidden="true"><span>FIG. 01 — CODE REACTOR</span><span>INPUT → STRUCTURE → EXPERIENCE</span></div><div class="hero-bottom"><a class="text-link" href="#work">Explore the work <span>↓</span></a><p>Logic underneath.<br/>Feeling on the surface.</p><span class="mono">SCROLL TO ENTER <span class="scroll-tick">↓</span></span></div></section>
